generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MEMBER
  GUEST
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum EventType {
  WEDDING
  CORPORATE
  BIRTHDAY
  CLUB_NIGHT
  FESTIVAL
  CAMPUS_EVENT
  PRIVATE_PARTY
  FULL_PACKAGE
}

enum BookingStatus {
  PENDING
  QUOTE_SENT
  CONFIRMED
  DEPOSIT_PAID
  COMPLETED
  CANCELLED
}

enum ServiceType {
  DJ
  MC_HOST
  LIGHTING
  SOUND_SYSTEM
  PHOTO_BOOTH
}

enum MediaType {
  MIX
  PODCAST
  LIVE_SET
  PROMO_VIDEO
  PHOTO
}

enum LeadStatus {
  NEW
  CONTACTED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SiteType {
  PERSONAL    // passion / lifestyle / creative / artiste (any art form)
  PORTFOLIO   // professional work & experience showcase
  CORPORATE   // business / company website
  REDIRECT    // 301 redirect to an external URL
}

enum PostContext {
  PORTFOLIO   // apps/portfolio blog
  KARSH_CORE  // apps/karsh-core blog
  TENANT      // CrowdVibe tenant blog (any SiteType)
}

// ─── Multi-Tenant Foundation ──────────────────────────────────────────────────

model Tenant {
  id            String       @id @default(cuid())
  name          String       @unique
  slug          String       @unique
  plan          TenantPlan   @default(FREE)
  status        TenantStatus @default(ACTIVE)
  customDomain  String?      @unique
  brandColor    String?      @default("#7C3AED")
  accentColor   String?      @default("#F59E0B")
  logoUrl       String?
  heroImageUrl  String?
  bio           String?
  location      String?
  instagramUrl  String?
  tiktokUrl     String?
  youtubeUrl    String?
  audiomackUrl  String?
  soundcloudUrl String?
  spotifyUrl    String?

  // Site type & external redirect
  siteType    SiteType @default(PERSONAL)
  redirectUrl String?

  // Google Calendar integration
  googleAccessToken  String?  @db.Text
  googleRefreshToken String?  @db.Text
  googleCalendarId   String?

  users                 User[]
  bookings              Booking[]
  mediaAssets           MediaAsset[]
  subscriptions         Subscription[]
  events                Event[]
  newsletterSubscribers NewsletterSubscriber[]
  posts                 Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Users & Auth (NextAuth) ──────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(GUEST)
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  clientName      String
  clientEmail     String
  clientPhone     String
  eventType       EventType
  eventDate       DateTime
  startTime       String
  endTime         String?
  venue           String
  venueAddress    String?
  guestCount      Int?
  services        ServiceType[]
  equipmentNeeded Boolean       @default(false)
  specialRequests String?       @db.Text
  basePrice       Float?
  totalPrice      Float?
  depositAmount   Float?
  depositPaid     Boolean       @default(false)
  status          BookingStatus @default(PENDING)
  stripePaymentId String?
  paystackRef     String?
  adminNotes            String?       @db.Text
  googleCalendarEventId String?
  invoiceUrl            String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

// ─── Media Assets ─────────────────────────────────────────────────────────────

model MediaAsset {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  title        String
  type         MediaType
  url          String
  thumbnailUrl String?
  duration     Int?
  description  String?    @db.Text
  platforms    String[]
  featured     Boolean    @default(false)
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ─── Portfolio Projects ───────────────────────────────────────────────────────

model Project {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?  @db.Text
  slug        String   @unique
  url         String?
  featuredImg String?
  emoji       String?
  color       String?
  tags        String[]
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Blog Posts ───────────────────────────────────────────────────────────────

model Post {
  id          String      @id @default(cuid())
  context     PostContext  @default(TENANT)
  tenantId    String?
  tenant      Tenant?     @relation(fields: [tenantId], references: [id])
  title       String
  slug        String
  excerpt     String?     @db.Text
  content     String      @db.Text
  coverImage  String?
  tags        String[]
  readingTime Int?
  featured    Boolean     @default(false)
  published   Boolean     @default(false)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([slug, context, tenantId])
}

// ─── Leads (Karsh Core) ───────────────────────────────────────────────────────

model Lead {
  id          String     @id @default(cuid())
  companyName String?
  contactName String
  email       String
  phone       String?
  projectType String
  budget      String?
  message     String?    @db.Text
  status      LeadStatus @default(NEW)
  source      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─── Events (DJ's upcoming gigs — fans view/RSVP) ────────────────────────────

model Event {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  description String?  @db.Text
  venue       String
  city        String?
  eventDate   DateTime
  startTime   String
  endTime     String?
  ticketUrl   String?
  imageUrl    String?
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Newsletter Subscribers ────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  email     String
  name      String?
  createdAt DateTime @default(now())

  @@unique([email, tenantId])
}

// ─── SaaS Subscriptions ───────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  plan                 TenantPlan
  status               SubscriptionStatus @default(TRIALING)
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}
